<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_change_password_wizard" model="ir.ui.view">
        <field name="name">change.password.wizard.form</field>
        <field name="model">dl.change.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Force Password Change">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        To guarantee account security, you must change your password before continuing.
                        <br/>
                        <strong>Requirements:</strong> Minimum 8 characters, at least one uppercase letter and one number or symbol.
                    </div>
                    <group>
                        <field name="password_current" password="True" string="Current Password" placeholder="Enter current password"/>
                        <field name="password_new" password="True" string="New Password" placeholder="Enter new password"/>
                        <field name="password_confirm" password="True" string="Confirm Password" placeholder="Confirm new password"/>
                    </group>
                </sheet>
                <footer>
                    <button name="change_password" string="Change Password" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_change_password_wizard" model="ir.actions.act_window">
        <field name="name">Change Password</field>
        <field name="res_model">dl.change.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
