<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="change_password_layout" name="Change Password">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Digitalub Security - Change Password</title>
                <link rel="stylesheet" href="/web/static/lib/bootstrap/css/bootstrap.css"/>
                <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&amp;display=swap" rel="stylesheet"/>
                <style>
                    body {
                        background: radial-gradient(circle at 10% 20%, rgb(10, 18, 30) 0%, rgb(20, 32, 48) 90%) !important;
                        font-family: 'Outfit', sans-serif !important;
                        color: #ffffff !important;
                        height: 100vh !important;
                        display: flex !important;
                        align-items: center !important;
                        justify-content: center !important;
                        margin: 0 !important;
                    }
                    .glass-card {
                        background: rgba(255, 255, 255, 0.02);
                        backdrop-filter: blur(20px) saturate(180%);
                        -webkit-backdrop-filter: blur(20px) saturate(180%);
                        border: 1px solid rgba(255, 255, 255, 0.08);
                        border-radius: 20px;
                        padding: 40px;
                        width: 100%;
                        max-width: 460px;
                        box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.5);
                        animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
                    }
                    @keyframes fadeIn {
                        from { opacity: 0; transform: translateY(20px); }
                        to { opacity: 1; transform: translateY(0); }
                    }
                    .logo-container {
                        text-align: center;
                        margin-bottom: 25px;
                    }
                    .logo-container h2 {
                        font-weight: 700;
                        letter-spacing: -0.5px;
                        margin-bottom: 5px;
                        background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        display: inline-block;
                    }
                    .logo-container p {
                        color: #a0aec0;
                        font-size: 0.95rem;
                        font-weight: 400;
                    }
                    .form-group {
                        margin-bottom: 18px;
                    }
                    .form-group label {
                        display: block;
                        font-size: 0.85rem;
                        font-weight: 600;
                        color: #cbd5e0;
                        margin-bottom: 6px;
                    }
                    .form-control-custom {
                        width: 100%;
                        background: rgba(255, 255, 255, 0.04);
                        border: 1px solid rgba(255, 255, 255, 0.1);
                        border-radius: 10px;
                        padding: 12px 16px;
                        color: #ffffff;
                        font-size: 0.95rem;
                        transition: all 0.3s ease;
                    }
                    .form-control-custom:focus {
                        outline: none;
                        background: rgba(255, 255, 255, 0.07);
                        border-color: #00f2fe;
                        box-shadow: 0 0 0 3px rgba(0, 242, 254, 0.15);
                    }
                    .requirements {
                        background: rgba(255, 255, 255, 0.01);
                        border-radius: 12px;
                        padding: 16px;
                        margin-bottom: 22px;
                        border: 1px solid rgba(255, 255, 255, 0.05);
                    }
                    .requirements h5 {
                        font-size: 0.85rem;
                        font-weight: 600;
                        color: #cbd5e0;
                        margin-top: 0;
                        margin-bottom: 10px;
                    }
                    .requirements ul {
                        list-style: none;
                        padding: 0;
                        margin: 0;
                    }
                    .requirements li {
                        font-size: 0.8rem;
                        color: #a0aec0;
                        margin-bottom: 6px;
                        display: flex;
                        align-items: center;
                        transition: color 0.3s ease;
                    }
                    .status-icon {
                        font-weight: bold;
                        margin-right: 8px;
                        display: inline-block;
                        width: 12px;
                    }
                    .requirements li.valid {
                        color: #48bb78 !important;
                    }
                    .requirements li.invalid {
                        color: #f56565 !important;
                    }
                    .requirements li.text-muted {
                        color: #a0aec0 !important;
                    }
                    .btn-submit {
                        width: 100%;
                        background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
                        border: none;
                        border-radius: 10px;
                        padding: 14px;
                        color: #0a121e;
                        font-weight: 700;
                        font-size: 1rem;
                        cursor: pointer;
                        transition: all 0.3s ease;
                        box-shadow: 0 4px 15px rgba(0, 242, 254, 0.25);
                    }
                    .btn-submit:hover:not(:disabled) {
                        transform: translateY(-1px);
                        box-shadow: 0 6px 20px rgba(0, 242, 254, 0.4);
                    }
                    .btn-submit:disabled {
                        background: linear-gradient(135deg, #4a5568 0%, #2d3748 100%);
                        color: #a0aec0;
                        cursor: not-allowed;
                        box-shadow: none;
                    }
                    .alert-custom {
                        background: rgba(245, 101, 101, 0.1);
                        border: 1px solid rgba(245, 101, 101, 0.2);
                        color: #feb2b2;
                        border-radius: 10px;
                        padding: 12px 16px;
                        font-size: 0.85rem;
                        margin-bottom: 20px;
                        display: flex;
                        align-items: center;
                    }
                    .alert-custom svg {
                        margin-right: 10px;
                        flex-shrink: 0;
                    }
                    .btn-logout {
                        display: block;
                        text-align: center;
                        margin-top: 20px;
                        color: #a0aec0;
                        font-size: 0.85rem;
                        text-decoration: none;
                        transition: color 0.2s ease;
                    }
                    .btn-logout:hover {
                        color: #ffffff;
                    }
                </style>
            </t>
            <div class="glass-card">
                <div class="logo-container">
                    <h2>DIGITALUB</h2>
                    <p>Password Security</p>
                </div>

                <t t-if="error">
                    <div class="alert-custom">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                        </svg>
                        <span><t t-out="error"/></span>
                    </div>
                </t>

                <form method="post" action="/dl_force_password_change/change_password" autocomplete="off">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    
                    <div class="form-group">
                        <label for="password_current">Current Password</label>
                        <input type="password" id="password_current" name="password_current" class="form-control-custom" required="required" placeholder="Enter current password"/>
                    </div>
                    <div class="form-group">
                        <label for="password_new">New Password</label>
                        <input type="password" id="password_new" name="password_new" class="form-control-custom" required="required" placeholder="Create a new password"/>
                    </div>
                    <div class="form-group">
                        <label for="password_confirm">Confirm New Password</label>
                        <input type="password" id="password_confirm" name="password_confirm" class="form-control-custom" required="required" placeholder="Repeat new password"/>
                    </div>

                    <div class="requirements">
                        <h5>Security Requirements:</h5>
                        <ul>
                            <li id="req-length" class="text-muted"><span class="status-icon">•</span>Minimum 8 characters</li>
                            <li id="req-upper" class="text-muted"><span class="status-icon">•</span>At least one uppercase letter</li>
                            <li id="req-special" class="text-muted"><span class="status-icon">•</span>At least one number or special character</li>
                            <li id="req-match" class="text-muted"><span class="status-icon">•</span>Passwords match</li>
                        </ul>
                    </div>

                    <button type="submit" class="btn-submit" disabled="disabled">Update Password</button>
                </form>

                <a href="/web/session/logout" class="btn-logout">Sign Out</a>
            </div>

            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function() {
                    const passwordNew = document.getElementById('password_new');
                    const passwordConfirm = document.getElementById('password_confirm');
                    const submitBtn = document.querySelector('.btn-submit');

                    const reqLength = document.getElementById('req-length');
                    const reqUpper = document.getElementById('req-upper');
                    const reqSpecial = document.getElementById('req-special');
                    const reqMatch = document.getElementById('req-match');

                    function validatePassword() {
                        const val = passwordNew.value;
                        const valConfirm = passwordConfirm.value;

                        if (!val) {
                            resetStatus(reqLength);
                            resetStatus(reqUpper);
                            resetStatus(reqSpecial);
                            resetStatus(reqMatch);
                            submitBtn.disabled = true;
                            return;
                        }

                        // 8 chars
                        const hasLength = val.length >= 8;
                        updateStatus(reqLength, hasLength);

                        // Upper case
                        const hasUpper = /[A-Z]/.test(val);
                        updateStatus(reqUpper, hasUpper);

                        // Number or Special char
                        const hasSpecial = /[0-9!@#$%^&amp;*(),.?\":{}|&lt;&gt;]/.test(val);
                        updateStatus(reqSpecial, hasSpecial);

                        // Match
                        const match = valConfirm &amp;&amp; val === valConfirm;
                        updateStatus(reqMatch, match);

                        submitBtn.disabled = !(hasLength &amp;&amp; hasUpper &amp;&amp; hasSpecial &amp;&amp; match);
                    }

                    function updateStatus(element, isValid) {
                        if (isValid) {
                            element.classList.remove('text-muted', 'invalid');
                            element.classList.add('valid');
                            element.querySelector('.status-icon').innerHTML = '✓ ';
                        } else {
                            element.classList.remove('valid', 'text-muted');
                            element.classList.add('invalid');
                            element.querySelector('.status-icon').innerHTML = '✗ ';
                        }
                    }

                    function resetStatus(element) {
                        element.classList.remove('valid', 'invalid');
                        element.classList.add('text-muted');
                        element.querySelector('.status-icon').innerHTML = '• ';
                    }

                    passwordNew.addEventListener('input', validatePassword);
                    passwordConfirm.addEventListener('input', validatePassword);
                });
            </script>
        </t>
    </template>
</odoo>
