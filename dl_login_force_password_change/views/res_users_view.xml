<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form" model="ir.ui.view">
        <field name="name">res.users.form.must.change.password</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group name="dl_password_security_group">
                    <label for="must_change_password" string="Password Security"/>
                    <div>
                        <div class="d-flex align-items-center">
                            <field name="must_change_password" class="oe_inline me-2"/>
                            <label for="must_change_password" string="Force Password Change on Next Login" class="oe_inline me-3"/>
                            <button
                                name="action_reset_password"
                                string="Force Now"
                                type="object"
                                class="oe_link"
                                attrs="{'invisible': [('must_change_password', '=', True)]}"
                            />
                        </div>
                        <div attrs="{'invisible': [('password_last_changed', '=', False)]}" class="text-muted small mt-1">
                            <span class="me-1">Last changed:</span>
                            <field name="password_last_changed" readonly="1" class="oe_inline"/>
                        </div>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
